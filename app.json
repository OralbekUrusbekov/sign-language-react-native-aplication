{
  "expo": {
    "name": "Sign Language App",
    "slug": "sign-language-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tyndau-logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/tyndau-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signlanguage.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sign language тану үшін камера қажет",
        "NSMicrophoneUsageDescription": "Дауысты текстке айналдыру үшін микрофон қажет"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/tyndau-logo.jpg",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.signlanguage.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/tyndau-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
  "react-native-vision-camera",
  {
    "cameraPermissionText": "Sign language тану үшін камера қажет",
    "enableMicrophonePermission": false,
    "enableFrameProcessors": false
  }
],
      "expo-web-browser"
    ],
    "scheme": "signlanguageapp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5bac8e5-66e9-4d53-91d2-754a54ee1982"
      }
    }
  }
}
